# Admin Authentication (Configure securely in Render Dashboard -> Environment Variables)
# User IDs: "itbdoe" and "doeadmin"
# Never commit plaintext passwords to source control.
ADMIN_ITBDOE_PASSWORD=your_secure_password_for_itbdoe
ADMIN_DOEADMIN_PASSWORD=your_secure_password_for_doeadmin

# Persistent Disk Mount (e.g. Render Persistent Disk or Cloud Volume)
# Mount path to store db.json and uploads directory permanently across container restarts
PERSISTENT_DIR=

